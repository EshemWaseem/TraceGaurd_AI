# ==============================================================================
# TraceGuard AI — Environment Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit .env containing real credentials to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Host dev connection to Docker Compose PostgreSQL container (host port 5434):
DATABASE_URL=postgresql+psycopg://traceguard_user:your_secure_password_here@127.0.0.1:5434/traceguard_db

# Inside Docker container connection (internal port 5432):
# DATABASE_URL=postgresql+psycopg://traceguard_user:your_secure_password_here@db:5432/traceguard_db

# Managed PostgreSQL URL (e.g., Render, Neon, Supabase, Cloud SQL):
# DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/database_name

# Docker Compose PostgreSQL Service Environment
POSTGRES_USER=traceguard_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=traceguard_db

# Security & Cryptography
# Generate a strong 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=your_secure_random_secret_key_32_characters_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment & Cookie Security
ENVIRONMENT=development
# Set COOKIE_SECURE to true when serving over HTTPS in production (Render, Vercel)
COOKIE_SECURE=false

# Networking & Reverse Proxy (Production & Cloud Deployment)
# Comma-separated allowed CORS origins (leave blank for local development defaults):
# CORS_ORIGINS=https://traceguard-app.vercel.app,http://localhost:5173
# Reverse proxy CIDRs or trusted proxies (e.g., 10.0.0.0/8 or 127.0.0.1):
TRUSTED_PROXIES=

# Backend Host & Port Configuration
HOST=127.0.0.1
PORT=8010

# Frontend API Target (Vite dev proxy or Vercel environment variable)
VITE_API_URL=http://127.0.0.1:8010
